[Unit]
Description=OpenArm Lab local simulation
StartLimitIntervalSec=0
Wants=openarm-act.service openarm-curobo.service

[Service]
Type=simple
WorkingDirectory=@OPENARMSIM_ROOT@
ExecStart=/usr/bin/systemd-inhibit --what=sleep --mode=block --who=OpenArmSim "--why=OpenArm simulation and experiments are running" @OPENARMSIM_PYTHON@ -B -m tools.object_workbench
Environment=MUJOCO_GL=egl
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OPENARM_POLICY_CONFIG=@OPENARMSIM_POLICY@
Environment=OPENARM_SCENE_OBJECTS=[]
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
